{
  "name": "tsnav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test",
    "pages:dev": "pnpm build && wrangler pages dev",
    "deploy": "pnpm check && pnpm build && wrangler pages deploy"
  },
  "dependencies": {
    "@iconify-icons/material-symbols": "^2.0.9",
    "@iconify-icons/simple-icons": "^2.0.8",
    "@material/web": "^2.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "wrangler": "^4.158.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
